{{!
    @template local_gojuon/bar

    Gojūon index bar for the course participants page.

    The bar is a navigation landmark holding one row of index chips per
    filterable name column. It is rendered server-side by the hook; the AMD
    module local_gojuon/gojuon wires the chips to the participants dynamic
    table at runtime.

    Context variables required for this template:
    * arialabel string - Localised accessible label for the nav landmark.
    * bars array - One entry per filterable name column:
        * filter string - Dynamic-table filter name (e.g. kanalast).
        * label string - Localised column label.
        * chips array - Index buttons in display order:
            * key string - Row key (all, a, ka, ..., la-lz, other).
            * label string - Button text.
            * active bool - Whether this chip starts pressed (drives the active class).
            * ariapressed string - "true"/"false" for the initial aria-pressed state.

    Example context (json):
    {
        "arialabel": "Filter participants by kana",
        "bars": [
            {
                "filter": "kanalast",
                "label": "Last name",
                "chips": [
                    {"key": "all", "label": "すべて", "active": true, "ariapressed": "true"},
                    {"key": "a", "label": "あ", "active": false, "ariapressed": "false"},
                    {"key": "other", "label": "他", "active": false, "ariapressed": "false"}
                ]
            }
        ]
    }
}}
<nav class="local-gojuon-bar mb-3" aria-label="{{arialabel}}">
    {{#bars}}
        <div class="local-gojuon-barrow d-flex flex-wrap align-items-center mb-1" data-filter="{{filter}}"
             data-region="local-gojuon-{{filter}}"
             role="group" aria-labelledby="{{uniqid}}-label-{{filter}}">
            <span class="local-gojuon-barlabel me-2 text-muted" id="{{uniqid}}-label-{{filter}}">{{label}}</span>
            {{#chips}}
                <button type="button" class="btn btn-secondary btn-sm local-gojuon-chip{{#active}} active{{/active}}"
                        data-row="{{key}}" data-filter="{{filter}}" aria-pressed="{{ariapressed}}"
                        {{#lang}}lang="{{lang}}" {{/lang}}>{{label}}</button>
            {{/chips}}
        </div>
    {{/bars}}
</nav>
<div class="local-gojuon-live sr-only" aria-live="polite" aria-atomic="true"></div>
